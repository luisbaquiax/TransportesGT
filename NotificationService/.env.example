# Perfil por defecto: dev o prod
SPRING_PROFILES_DEFAULT=dev

# ========================================
# SPRING DATASOURCE CONFIGURATION
# ========================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bd_notificaciones
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_dev

# ========================================
# SERVER CONFIGURATION
# ========================================
SERVER_PORT=8088

# ========================================
# CORS CONFIGURATION
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://d3utr3yg9woi1d.cloudfront.net

# ========================================
# JWT CONFIGURATION
# ========================================
JWT_SECRET=d766b3eb3a78dbbbda222d3341f38fa7e3674868102221b384598fbb596586b2
# 1000 * 60 * 60 * 24 = 86400000 (1 day)
JWT_EXPIRATION_MS=864000000

# ---------------------------------------------------------------
# RabbitMQ
# Local (Docker): amqp://guest:guest@localhost:5672
# CloudAMQP:      amqps://usuario:contrasena@host.rmq.cloudamqp.com/vhost
# ---------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672

JWT_ISSUER=servicio-identidad

# ========================================
# CORREO (SMTP)
# Producción (Gmail u otro): MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true
# Local con Mailpit (bandeja en http://localhost:8025):
# ========================================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_REMITENTE=Transportes GT <no-responder@transportes.gt>

# Frontend para los enlaces de activación y restablecimiento de contraseña
FRONTEND_URL=http://localhost:5173
