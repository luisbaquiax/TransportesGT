      ]
    },
    {
      "name": "Abordaje y PDF",
      "item": [
        {
          "name": "Boletos en PDF (comprador)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/boletos/compras/{{idCompra}}/pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boletos",
                "compras",
