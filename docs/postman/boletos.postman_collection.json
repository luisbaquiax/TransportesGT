          }
        },
        {
          "name": "Registrar abordaje (CAJ/SUC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCajero}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigoBoleto}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/boletos/viajes/{{idViaje}}/abordajes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boletos",
                "viajes",
                "{{idViaje}}",
                "abordajes"
              ]
            },
            "description": "201 la primera vez, 200 si se repite. 409 si el boleto es de otro viaje, está anulado o el viaje ya salió."
          }
