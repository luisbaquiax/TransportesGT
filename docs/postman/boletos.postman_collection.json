                "pdf"
              ]
            },
            "description": "PDF con un QR por boleto. Mismos permisos que el detalle; 409 si la compra no está CONFIRMADA. En Postman use Send and Download."
          }
        },
        {
          "name": "Lista de pasajeros (CAJ/SUC)",
          "request": {
            "method": "GET",
