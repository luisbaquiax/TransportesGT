              ]
            },
            "description": "CAJERO o ADMIN_SUCURSAL de la sucursal de origen del viaje (otra sucursal → 403 SIN_PERMISO). Sin nitComprador = CF. Sin nombre: el del perfil con ese NIT o 'Consumidor final'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCompra\": \"{{idCompra}}\",\n  \"idViaje\": \"{{idViaje}}\",\n  \"asientos\": [\n    20\n  ],\n  \"nitComprador\": \"{{nit}}\",\n  \"nombreComprador\": \"Ana López\",\n  \"fechaPago\": \"{{fechaHoy}}\"\n}",
              "options": {
