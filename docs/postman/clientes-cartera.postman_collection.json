{
  "info": {
    "name": "Clientes y Cartera (servicio-clientes)",
    "_postman_id": "8c1e5c55-7f0a-4b8e-9a51-clientescartera",
    "description": "Endpoints de CustomerWalletService (puerto 8085, context-path /v1/customers). Variables: baseUrl (directo http://localhost:8085/v1/customers o por gateway http://localhost:8080/v1/customers), token (JWT de un CLIENTE emitido por Identidad), tokenCajero (JWT de CAJERO o ADMIN_SUCURSAL), claveInterna (= variable CLAVE_INTERNA del servicio). GET /cartera/pagos con X-Clave-Interna no se publica en el gateway: usar el puerto 8085.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085/v1/customers"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenCajero",
      "value": ""
    },
    {
      "key": "claveInterna",
      "value": "cambiar-en-local"
    },
    {
      "key": "nit",
      "value": "1234567-K"
    },
    {
      "key": "idReferencia",
      "value": ""
    },
    {
      "key": "fechaHoy",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set(\"fechaHoy\", new Date().toISOString().slice(0, 10));"
        ]
      }
    }
  ],
