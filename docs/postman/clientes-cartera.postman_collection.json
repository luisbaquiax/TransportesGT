    {
      "name": "Pagos (Interno: Boletos, Alquileres)",
      "item": [
        {
          "name": "Pagar una compra",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Clave-Idempotencia",
                "value": "{{idReferencia}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cartera/pagos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cartera",
                "pagos"
              ]
            },
            "description": "Lo llaman Boletos y Alquileres reenviando el JWT del usuario. 422 SALDO_INSUFICIENTE o PERFIL_INCOMPLETO.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoReferencia\": \"BOLETOS\",\n  \"idReferencia\": \"{{idReferencia}}\",\n  \"monto\": \"85.00\",\n  \"fechaPago\": \"{{fechaHoy}}\",\n  \"descripcion\": \"1 boleto Xela → Capital\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// La clave debe ser igual a idReferencia (idCompra)",
                  "pm.collectionVariables.set(\"idReferencia\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado esperado (201, 422)\", () => pm.expect(pm.response.code).to.be.oneOf([201, 422]));",
                  "if (pm.response.code === 201) { pm.test(\"Location\", () => pm.response.to.have.header(\"Location\")); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Repetir el pago (200, mismo idPago)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
