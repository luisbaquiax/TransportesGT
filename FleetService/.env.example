# Perfil por defecto: dev o prod
SPRING_PROFILES_DEFAULT=dev

# ========================================
# SPRING DATASOURCE CONFIGURATION
# ========================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5437/bd_flota
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin123

# ========================================
# SERVER CONFIGURATION
# ========================================
SERVER_PORT=8082

# ========================================
# CORS CONFIGURATION
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://d3utr3yg9woi1d.cloudfront.net

# ========================================
# JWT CONFIGURATION
# ========================================
JWT_SECRET=d766b3eb3a78dbbbda222d3341f38fa7e3674868102221b384598fbb596586b2
# 1000 * 60 * 60 * 24 = 86400000 (1 day)
JWT_EXPIRATION_MS=864000000

# ---------------------------------------------------------------
# RabbitMQ
# Local (Docker): amqp://guest:guest@localhost:5672
# CloudAMQP:      amqps://usuario:contrasena@host.rmq.cloudamqp.com/vhost
# ---------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ========================================
# VIAJES (llamadas sincronas, plan 2.6)
# URL base del TripService; incluye el context-path
# ========================================
VIAJES_URL=http://localhost:8083/v1/trips

# ========================================
# FOTOS de buses y choferes
# Son privadas: se leen con token por GET /buses/{id}/foto y GET /choferes/{id}/foto (vía gateway).
# Desarrollo: se guardan en disco (FOTOS_DIRECTORIO).
# Producción: Cloud Storage con bucket privado (sin lectura para allUsers), activando estas variables:
#   FOTOS_NUBE_HABILITADA=true
#   FOTOS_NUBE_BUCKET=mi-bucket
#   GOOGLE_APPLICATION_CREDENTIALS=/ruta/sa.json   (en Cloud Run no hace falta)
# ========================================
FOTOS_DIRECTORIO=./public/fotos
# Referencia interna que se guarda en foto_url; ya no se expone al frontend
FOTOS_URL_PUBLICA=http://localhost:8082/v1/fleet/fotos
FOTOS_TAMANIO_MAXIMO_BYTES=5242880
FOTOS_NUBE_HABILITADA=false
FOTOS_NUBE_BUCKET=
