            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda el token en {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@transportes.gt\",\n  \"contrasena\": \"Admin1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.collectionVariables.set('token', cuerpo.token);",
                  "pm.test('Devuelve token', () => pm.expect(cuerpo.token).to.be.a('string'));"
