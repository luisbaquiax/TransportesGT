
POSTGRES_USER=root
POSTGRES_PASSWORD=123456

# Contraseña de los usuarios svc_<servicio> (una por microservicio, misma en desarrollo)
# Evita comillas simples (') en este valor: el script de inicialización la usa dentro de SQL.
SVC_DB_PASSWORD=svc_dev

# RabbitMQ
RABBITMQ_USER=transportesgt
RABBITMQ_PASSWORD=transportesgt

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Frontend para los enlaces de activación y restablecimiento de contraseña
FRONTEND_URL=http://localhost:5173

# Clave interna Flota → Viajes (cabecera X-Clave-Interna en GET /viajes/activos).
# Debe ser el MISMO valor en todos los servicios que la usan.
CLAVE_INTERNA=cambiar-en-local

# URL de TripService para FleetService (en Docker compose ya se inyecta
# http://trip-service:8083/v1/trips; solo cámbiala para ejecuciones locales sin Docker)
# VIAJES_URL=http://localhost:8083/v1/trips

