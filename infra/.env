# Copia este archivo a .env y NO subas el .env al repositorio (agrégalo a .gitignore).
# En producción usa contraseñas distintas y robustas.

# Superusuario de PostgreSQL (solo para administración)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# Contraseña de los usuarios svc_<servicio> (una por microservicio, misma en desarrollo)
# Evita comillas simples (') en este valor: el script de inicialización la usa dentro de SQL.
SVC_DB_PASSWORD=svc_dev

# RabbitMQ
RABBITMQ_USER=transporte
RABBITMQ_PASSWORD=transporte_dev
