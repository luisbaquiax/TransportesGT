{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
    "name": "TransportesGT - Alquileres",
    "description": "servicio-alquileres. baseUrl directo: http://localhost:8086/v1/rentals · por el gateway: http://localhost:8080/v1/rentals. Ejecute primero un Login en la colección Identidad y copie el token a {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8086/v1/rentals"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "idAlquiler",
      "value": ""
    },
    {
      "key": "idSucursalOrigen",
      "value": "10000000-0000-4000-8000-000000000001"
    }
  ],
  "item": [
    {
      "name": "Flujo completo",
      "item": [
        {
          "name": "1. Solicitar en línea (cliente autenticado)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/alquileres/solicitudes",
              "host": ["{{baseUrl}}"],
              "path": ["alquileres", "solicitudes"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idSucursalOrigen\": \"10000000-0000-4000-8000-000000000001\",\n  \"nombreOrigen\": \"Quetzaltenango\",\n  \"nombreDestino\": \"Ciudad de Guatemala\",\n  \"fechaHoraSalida\": \"2026-11-01T08:00:00-06:00\",\n  \"idaYVuelta\": false,\n  \"fechaHoraRetorno\": null,\n  \"numeroPasajeros\": 30,\n  \"latitudOrigen\": 14.8333,\n  \"longitudOrigen\": -91.5167,\n  \"latitudDestino\": 14.6349,\n  \"longitudDestino\": -90.5069\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Guarda el id en {{idAlquiler}}. Requiere perfil de cliente con NIT. Precio estimado se calcula con Haversine × factor-carretera."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('idAlquiler', j.id);",
                  "pm.test('estado SOLICITADO', () => pm.expect(j.estado).to.eql('SOLICITADO'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Cotizar (ADMIN_SUCURSAL)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/alquileres/{{idAlquiler}}/cotizacion",
              "host": ["{{baseUrl}}"],
              "path": ["alquileres", "{{idAlquiler}}", "cotizacion"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precioFinal\": 4500.00,\n  \"fechaHoraLlegadaEstimada\": \"2026-11-01T12:00:00-06:00\",\n  \"comentario\": \"Disponibilidad confirmada\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "SOLICITADO/COTIZADO → COTIZADO. Publica AlquilerCotizado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('estado COTIZADO', () => pm.expect(j.estado).to.eql('COTIZADO'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Pagar en línea (dueño, saga Cartera)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/alquileres/{{idAlquiler}}/pago",
              "host": ["{{baseUrl}}"],
              "path": ["alquileres", "{{idAlquiler}}", "pago"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fechaPago\": \"2026-10-20\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Solo el dueño del alquiler en línea. Llama a Cartera con Clave-Idempotencia=idAlquiler. Si Cartera no responde, 503 y el alquiler queda COTIZADO."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK o 503 fail-closed', () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.test('estado CONFIRMADO', () => pm.expect(j.estado).to.eql('CONFIRMADO'));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Solicitudes",
      "item": [
        {
          "name": "Solicitud en línea",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/alquileres/solicitudes",
