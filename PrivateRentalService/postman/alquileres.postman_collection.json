    },
    {
      "name": "Consultas",
      "item": [
        {
          "name": "Mi historial",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alquileres/mios?pagina=0&tamano=20",
              "host": ["{{baseUrl}}"],
              "path": ["alquileres", "mios"],
              "query": [
                { "key": "pagina", "value": "0" },
                { "key": "tamano", "value": "20" }
              ]
            },
            "description": "Alquileres en línea del usuario + mostrador con su NIT."
          }
        },
        {
          "name": "Listar alquileres (SUC/CAJ/SIS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alquileres?pagina=0&tamano=20",
              "host": ["{{baseUrl}}"],
              "path": ["alquileres"],
              "query": [
                { "key": "estado", "value": "", "disabled": true, "description": "SOLICITADO, COTIZADO, CONFIRMADO, FINALIZADO, CANCELADO" },
                { "key": "desde", "value": "", "disabled": true, "description": "YYYY-MM-DD, día de Guatemala (incluido)" },
                { "key": "hasta", "value": "", "disabled": true },
                { "key": "sinAsignar", "value": "", "disabled": true, "description": "true = confirmados sin bus asignado" },
                { "key": "pagina", "value": "0" },
                { "key": "tamano", "value": "20", "description": "1 a 100" }
              ]
            },
            "description": "SUC y CAJ ven los de su sucursal; SIS ve todos."
          }
        },
        {
          "name": "Detalle de alquiler",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alquileres/{{idAlquiler}}",
              "host": ["{{baseUrl}}"],
              "path": ["alquileres", "{{idAlquiler}}"]
            },
            "description": "Cliente ve los suyos (en línea o de mostrador con el NIT de su perfil); SUC/CAJ los de su sucursal; SIS todos. Incluye historial de cotizaciones."
          }
        }
      ]
    },
    {
