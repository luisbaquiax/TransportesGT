                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('idAlquiler', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Solicitud en mostrador (SUC/CAJ)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/alquileres/mostrador",
              "host": ["{{baseUrl}}"],
              "path": ["alquileres", "mostrador"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solicitud\": {\n    \"idSucursalOrigen\": \"10000000-0000-4000-8000-000000000001\",\n    \"origen\": \"Quetzaltenango\",\n    \"destino\": \"Huehuetenango\",\n    \"fechaHoraSalida\": \"2026-11-02T09:00:00-06:00\",\n    \"idaYVuelta\": true,\n    \"fechaHoraRetorno\": \"2026-11-02T18:00:00-06:00\",\n    \"numeroPasajeros\": 20,\n    \"latitudOrigen\": 14.8333,\n    \"longitudOrigen\": -91.5167,\n    \"latitudDestino\": 15.3199,\n    \"longitudDestino\": -91.47\n  },\n  \"nitCliente\": \"1234567-8\",\n  \"nombreCliente\": \"Cliente Mostrador\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Canal MOSTRADOR. Cuerpo anidado: solicitud (mismos campos que en línea) + nitCliente (vacío o CF = consumidor final; se normaliza) + nombreCliente (obligatorio)."
          }
        }
      ]
    },
